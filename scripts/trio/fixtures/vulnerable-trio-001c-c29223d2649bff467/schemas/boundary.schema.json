{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pehverse.invalid/schemas/trio-boundary-2.0.0.json",
  "title": "TRIO closed behavioral inventory",
  "type": "object",
  "required": ["schemaVersion","status","validator","pathPolicy","repositories","exclusions","rules","packageBehaviorFields","blockingDivergences"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type":"string","maxLength":256},
    "schemaVersion": {"const":"2.0.0"},
    "status": {"const":"characterization"},
    "validator": {
      "type":"object","required":["name","version","draft"],"additionalProperties":false,
      "properties":{"name":{"const":"ajv"},"version":{"const":"8.20.0"},"draft":{"const":"https://json-schema.org/draft/2020-12/schema"}}
    },
    "pathPolicy": {
      "type":"object","required":["unicodeNormalization","caseSensitivity","symlinks","unknownFiles"],"additionalProperties":false,
      "properties":{"unicodeNormalization":{"const":"NFC"},"caseSensitivity":{"const":"case-sensitive-with-casefold-collision-rejection"},"symlinks":{"const":"reject-all-in-scope"},"unknownFiles":{"const":"fail-closed"}}
    },
    "repositories": {
      "type":"object","required":["pehlichi","loony-luna","mad-ptah"],"additionalProperties":false,
      "properties":{"pehlichi":{"$ref":"#/$defs/repository"},"loony-luna":{"$ref":"#/$defs/repository"},"mad-ptah":{"$ref":"#/$defs/repository"}}
    },
    "exclusions": {"type":"array","maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/exclusion"}},
    "rules": {"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/rule"}},
    "packageBehaviorFields": {
      "type":"array","minItems":1,"maxItems":64,"uniqueItems":true,
      "items":{"type":"string","enum":["version","type","private","scripts","main","module","types","browser","exports","imports","bin","dependencies","optionalDependencies","peerDependencies","peerDependenciesMeta","devDependencies","engines","packageManager","workspaces","overrides","resolutions","files","sideEffects","pnpm","babel","browserslist","tsx","ts-node"]}
    },
    "blockingDivergences": {"type":"array","maxItems":128,"items":{"$ref":"#/$defs/blocker"}}
  },
  "$defs": {
    "safePath": {"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\u0000-\\u001f\\u007f\\\\]+$"},
    "repository": {
      "type":"object","required":["expectedRepositoryName","remoteIdentity","capsulePath","capsuleIdentity","packageNames"],"additionalProperties":false,
      "properties":{
        "expectedRepositoryName":{"type":"string","pattern":"^[a-z0-9-]+$","maxLength":64},
        "remoteIdentity":{"type":"string","pattern":"^github\\.com/RootZ3n/[a-z0-9-]+$","maxLength":128},
        "capsulePath":{"$ref":"#/$defs/safePath"},"capsuleIdentity":{"type":"string","pattern":"^[a-z0-9-]+$","maxLength":64},
        "packageNames":{"type":"object","required":["package.json","tui/package.json"],"additionalProperties":false,"properties":{"package.json":{"type":"string","maxLength":128},"tui/package.json":{"type":"string","maxLength":128}}}
      }
    },
    "exclusion": {
      "type":"object","required":["path","kind","attestation"],"additionalProperties":false,
      "properties":{"path":{"$ref":"#/$defs/safePath"},"kind":{"enum":["git-metadata","dependency-tree","cache-tree"]},"attestation":{"type":"string","minLength":8,"maxLength":256}}
    },
    "selector": {
      "oneOf":[
        {"type":"object","required":["paths"],"additionalProperties":false,"properties":{"paths":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/safePath"}}}},
        {"type":"object","required":["directory"],"additionalProperties":false,"properties":{"directory":{"$ref":"#/$defs/safePath"},"excludedPaths":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/safePath"}},"excludedDirectories":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/safePath"}},"allowedSuffixes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^\\.[a-z0-9.]+$","maxLength":16}}}}
      ]
    },
    "validation": {
      "type":"object","required":["kind"],"additionalProperties":false,
      "properties":{"kind":{"enum":["none","boundary-schema","capsule-schema","deployment-schema","capability-pack-schema","runtime-manifest-schema","package-behavior","strict-json-data","inert-image","documentation","quarantine"]},"schemaRef":{"$ref":"#/$defs/safePath"}}
    },
    "rule": {
      "type":"object","required":["id","selector","class","bytesMustMatch","modeMustMatch","allowedTypes","permittedFormats","validation","productionReachable","divergenceBlocking","transitional","expiresBefore"],"additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$","maxLength":64},"selector":{"$ref":"#/$defs/selector"},
        "class":{"enum":["behavior-identical","validated-variable-data","inert-variable-asset","generated-behavior-identical","documentation","test-behavior-identical","quarantined-blocking-divergence"]},
        "bytesMustMatch":{"type":"boolean"},"modeMustMatch":{"const":true},"allowedTypes":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["file"]}},
        "permittedFormats":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","maxLength":32}},"validation":{"$ref":"#/$defs/validation"},
        "productionReachable":{"type":"boolean"},"divergenceBlocking":{"type":"boolean"},"transitional":{"type":"boolean"},"expiresBefore":{"type":["string","null"],"maxLength":128}
      }
    },
    "blocker": {
      "type":"object","required":["path","category","expiresBefore","reason"],"additionalProperties":false,
      "properties":{"path":{"$ref":"#/$defs/safePath"},"category":{"type":"string","maxLength":64},"expiresBefore":{"type":"string","maxLength":128},"reason":{"type":"string","maxLength":512}}
    }
  }
}
