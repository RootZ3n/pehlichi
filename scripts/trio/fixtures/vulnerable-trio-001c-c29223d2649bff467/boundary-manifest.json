    {"id":"ui-quarantine","selector":{"directory":"ui"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["browser-code","html","css","asset"],"validation":{"kind":"quarantine"},"productionReachable":true,"divergenceBlocking":true,"transitional":true,"expiresBefore":"executable UI mechanism extraction"},
    {"id":"tui-ui-quarantine","selector":{"directory":"tui/ui"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["browser-code","html","css","asset"],"validation":{"kind":"quarantine"},"productionReachable":true,"divergenceBlocking":true,"transitional":true,"expiresBefore":"executable UI mechanism extraction"},
    {"id":"tui-public-quarantine","selector":{"directory":"tui/public"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["browser-code","html","css","asset"],"validation":{"kind":"quarantine"},"productionReachable":true,"divergenceBlocking":true,"transitional":true,"expiresBefore":"executable UI mechanism extraction"},
    {"id":"tui-web-quarantine","selector":{"directory":"tui/web"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["browser-code","html","css","asset","documentation"],"validation":{"kind":"quarantine"},"productionReachable":true,"divergenceBlocking":true,"transitional":true,"expiresBefore":"legacy UI adjudication"},
