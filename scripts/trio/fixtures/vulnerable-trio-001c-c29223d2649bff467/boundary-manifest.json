    {"id":"agent-dev-quarantine","selector":{"directory":".agents"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["configuration","code","data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"development overlay adjudication"},
    {"id":"codex-dev-quarantine","selector":{"directory":".codex"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["configuration","code","data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"development overlay adjudication"},
    {"id":"claude-dev-quarantine","selector":{"directory":".claude"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["configuration","code","data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"development overlay adjudication"},
    {"id":"demo-factory-quarantine","selector":{"directory":"interview-demo-factory"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["code","asset","data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"demo fixture extraction"},
    {"id":"my-os-quarantine","selector":{"directory":"my-os"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["code","asset","data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"overlay adjudication"},
    {"id":"out-quarantine","selector":{"directory":"out"},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["generated-data"],"validation":{"kind":"quarantine"},"productionReachable":false,"divergenceBlocking":true,"transitional":true,"expiresBefore":"generated-output adjudication"}
