    {"path":"scripts/trio/node_modules","kind":"dependency-tree","attestation":"scripts/trio/package-lock.json governed and pinned"},
    {"path":"coverage","kind":"cache-tree","attestation":"test coverage cache; no production entry point may load it"},
    {"path":".next","kind":"cache-tree","attestation":"framework build cache only; compiled artifacts remain governed elsewhere"}
