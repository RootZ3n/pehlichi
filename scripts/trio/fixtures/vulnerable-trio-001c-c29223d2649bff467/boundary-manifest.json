  "repositories": {
    "pehlichi": {"expectedRepositoryName":"pehlichi","remoteIdentity":"github.com/RootZ3n/pehlichi","capsulePath":"trio/capsules/pehlichi.json","capsuleIdentity":"pehlichi","packageNames":{"package.json":"pehlichi","tui/package.json":"peh-tui"}},
    "loony-luna": {"expectedRepositoryName":"loony-luna","remoteIdentity":"github.com/RootZ3n/loony-luna","capsulePath":"trio/capsules/loony-luna.json","capsuleIdentity":"luna","packageNames":{"package.json":"loony-luna","tui/package.json":"luna-tui"}},
