  "packageBehaviorFields": ["version","type","private","scripts","main","module","types","browser","exports","imports","bin","dependencies","optionalDependencies","peerDependencies","peerDependenciesMeta","devDependencies","engines","packageManager","workspaces","overrides","resolutions","files","sideEffects","pnpm","babel","browserslist","tsx","ts-node"],
  "blockingDivergences": [
    {"path":"tui/src/server.ts","category":"live-server-control-flow","expiresBefore":"TRIO convergence and TRIO-000 restart","reason":"Identity, deployment, Ptah-only capability activation, and output guard wiring remain behaviorally divergent."},
    {"path":"src/profiles/agent.ts","category":"executable-capsule-overlay","expiresBefore":"capsule extraction","reason":"Agent identity is implemented in executable TypeScript and public/compiled exports."},
    {"path":"ui","category":"executable-ui-overlay","expiresBefore":"UI mechanism extraction","reason":"Inline scripts and served browser code are mixed with branding."},
    {"path":"skills","category":"executable-skill-overlay","expiresBefore":"skills extraction","reason":"Ptah contains executable TypeScript under a nominally variable skills tree."},
