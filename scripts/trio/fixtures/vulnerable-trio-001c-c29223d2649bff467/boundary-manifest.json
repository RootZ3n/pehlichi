    {"id":"repository-control","selector":{"paths":[".gitignore"]},"class":"behavior-identical","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["text"],"validation":{"kind":"none"},"productionReachable":false,"divergenceBlocking":true,"transitional":false,"expiresBefore":null},
    {"id":"source-runtime","selector":{"directory":"src"},"class":"behavior-identical","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["typescript"],"validation":{"kind":"none"},"productionReachable":true,"divergenceBlocking":true,"transitional":false,"expiresBefore":null},
    {"id":"tui-source-runtime","selector":{"directory":"tui/src","excludedPaths":["tui/src/server.ts"]},"class":"behavior-identical","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["typescript","tsx"],"validation":{"kind":"none"},"productionReachable":true,"divergenceBlocking":true,"transitional":false,"expiresBefore":null},
    {"id":"server-quarantine","selector":{"paths":["tui/src/server.ts"]},"class":"quarantined-blocking-divergence","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["typescript"],"validation":{"kind":"quarantine"},"productionReachable":true,"divergenceBlocking":true,"transitional":true,"expiresBefore":"TRIO convergence and TRIO-000 restart"},
    {"id":"compiled-behavior","selector":{"directory":"dist"},"class":"generated-behavior-identical","bytesMustMatch":true,"modeMustMatch":true,"allowedTypes":["file"],"permittedFormats":["javascript","typescript-declaration","source-map"],"validation":{"kind":"none"},"productionReachable":true,"divergenceBlocking":true,"transitional":false,"expiresBefore":null},
