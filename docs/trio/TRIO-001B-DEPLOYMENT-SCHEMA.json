{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pehverse.local/schemas/trio-deployment-v1.json",
  "title": "Trio Deployment Configuration",
  "type": "object",
  "required": ["schemaVersion", "listen", "credentialHandles", "workspaceRegistrationSources", "serviceEndpoints", "transports", "locations", "limits", "compatibilityAdapters"],
  "properties": {
    "schemaVersion":{"const":"1.0.0"},
    "listen":{"type":"object","required":["address","port"],"properties":{"address":{"type":"string"},"port":{"type":"integer","minimum":1,"maximum":65535}},"additionalProperties":false},
    "credentialHandles":{"type":"array","items":{"type":"object","required":["id","provider"],"properties":{"id":{"type":"string","pattern":"^[a-zA-Z0-9._-]+$"},"provider":{"enum":["environment-handle","systemd-credential","keyring-handle","file-descriptor"]}},"additionalProperties":false}},
    "workspaceRegistrationSources":{"type":"array","items":{"type":"object","required":["id","kind"],"properties":{"id":{"type":"string"},"kind":{"enum":["configured-default","signed-howa-fixture-registry"]}},"additionalProperties":false}},
    "serviceEndpoints":{"type":"array","items":{"type":"object","required":["id","urlHandle","optional"],"properties":{"id":{"type":"string"},"urlHandle":{"type":"string"},"optional":{"type":"boolean"}},"additionalProperties":false}},
    "transports":{"type":"array","items":{"enum":["http","streaming-http","matrix","cli","direct-library"]},"uniqueItems":true},
    "locations":{"type":"object","required":["checkpointHandle","receiptHandle"],"properties":{"checkpointHandle":{"type":"string"},"receiptHandle":{"type":"string"}},"additionalProperties":false},
    "limits":{"type":"object","required":["maxConcurrentTasks","maxIterations","taskTimeoutMs","memoryLimitMb"],"properties":{"maxConcurrentTasks":{"type":"integer","minimum":1},"maxIterations":{"type":"integer","minimum":1},"taskTimeoutMs":{"type":"integer","minimum":1},"memoryLimitMb":{"type":"integer","minimum":1}},"additionalProperties":false},
    "compatibilityAdapters":{"type":"array","items":{"type":"object","required":["id","consumerEvidenceRef","deprecatedSince","removeBefore"],"properties":{"id":{"type":"string"},"consumerEvidenceRef":{"type":"string"},"deprecatedSince":{"type":"string"},"removeBefore":{"const":"1.0.0"}},"additionalProperties":false}}
  },
  "additionalProperties": false,
  "description": "Plaintext secrets, literal credential values, arbitrary workspace roots, caller-selected roots, authority grants, and switches disabling mandatory safety invariants are not fields in this closed schema."
}
