{
 "$schema": "./schemas/boundary.schema.json",
 "blockingDivergences": [
  {
   "category": "executable-capsule-overlay",
   "expiresBefore": "capsule extraction",
   "path": "src/profiles/agent.ts",
   "reason": "Agent identity is implemented in executable TypeScript and public/compiled exports."
  },
  {
   "category": "executable-ui-overlay",
   "expiresBefore": "UI mechanism extraction",
   "path": "ui",
   "reason": "Inline scripts and served browser code are mixed with branding."
  },
  {
   "category": "executable-skill-overlay",
   "expiresBefore": "skills extraction",
   "path": "skills",
   "reason": "Ptah contains executable TypeScript under a nominally variable skills tree."
  },
  {
   "category": "compiled-artifact-drift",
   "expiresBefore": "reproducible canonical build",
   "path": "dist",
   "reason": "Compiled output must compare or be rebuilt; it is never ignored as generated."
  }
 ],
 "exclusions": [
  {
   "allowedTypes": [
    "directory",
    "file"
   ],
   "attestation": "Git metadata read only through explicit identity/status commands; a worktree stores it as a file",
   "kind": "git-metadata",
   "path": ".git"
  },
  {
   "attestation": "pnpm-lock.yaml governed; dependency installation is not source",
   "kind": "dependency-tree",
   "path": "node_modules"
  },
  {
   "attestation": "tui/pnpm-lock.yaml governed; dependency installation is not source",
   "kind": "dependency-tree",
   "path": "tui/node_modules"
  },
  {
   "attestation": "scripts/trio/package-lock.json governed and pinned",
   "kind": "dependency-tree",
   "path": "scripts/trio/node_modules"
  }
 ],
 "packageBehaviorFields": [
  "version",
  "type",
  "private",
  "scripts",
  "main",
  "module",
  "types",
  "typesVersions",
  "browser",
  "exports",
  "imports",
  "bin",
  "man",
  "directories",
  "dependencies",
  "optionalDependencies",
  "peerDependencies",
  "peerDependenciesMeta",
  "devDependencies",
  "bundleDependencies",
  "bundledDependencies",
  "engines",
  "os",
  "cpu",
  "libc",
  "packageManager",
  "workspaces",
  "overrides",
  "resolutions",
  "files",
  "sideEffects",
  "preferGlobal",
  "publishConfig",
  "config",
  "gypfile",
  "binary",
  "pnpm",
  "babel",
  "browserslist",
  "tsx",
  "ts-node",
  "jest",
  "vitest",
  "ava",
  "mocha"
 ],
 "pathInventory": {
  "path": "path-inventory.json",
  "schemaVersion": "1.0.0"
 },
 "pathPolicy": {
  "caseSensitivity": "case-sensitive-with-casefold-collision-rejection",
  "symlinks": "reject-all-in-scope",
  "unicodeNormalization": "NFC",
  "unknownFiles": "fail-closed"
 },
 "repositories": {
  "loony-luna": {
   "capsuleIdentity": "luna",
   "capsulePath": "trio/governance/capsules/loony-luna.json",
   "expectedRepositoryName": "loony-luna",
   "packageNames": {
    "package.json": "loony-luna",
    "tui/package.json": "trio-agent-tui"
   },
   "remoteIdentity": "github.com/RootZ3n/loony-luna"
  },
  "mad-ptah": {
   "capsuleIdentity": "ptah",
   "capsulePath": "trio/governance/capsules/mad-ptah.json",
   "expectedRepositoryName": "mad-ptah",
   "packageNames": {
    "package.json": "mad-ptah",
    "tui/package.json": "trio-agent-tui"
   },
   "remoteIdentity": "github.com/RootZ3n/mad-ptah"
  },
  "pehlichi": {
   "capsuleIdentity": "pehlichi",
   "capsulePath": "trio/governance/capsules/pehlichi.json",
   "expectedRepositoryName": "pehlichi",
   "packageNames": {
    "package.json": "pehlichi",
    "tui/package.json": "trio-agent-tui"
   },
   "remoteIdentity": "github.com/RootZ3n/pehlichi"
  }
 },
